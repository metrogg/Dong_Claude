# DongClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
DONG_HOST=127.0.0.1
DONG_PORT=7437

# ── Logging ───────────────────────────────────────────────────
DONG_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
DONG_LOG_FILE=~/.dong/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
DONG_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# DONG_CONFIG=~/.dong/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# DONG_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# DONG_MAX_STEPS=20
